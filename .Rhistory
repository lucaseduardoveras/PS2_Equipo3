# === Reducir número de puntos si hay más de 1 millón ===
if (nrow(roc_total) > 1000000) {
set.seed(2025)
roc_total <- roc_total %>% sample_n(10000) %>% arrange(Modelo, FPR)
}
# === Combinar los resultados de ROC ===
roc_total <- bind_rows(roc_base, roc_up, roc_down)
# === Reducir número de puntos si hay más de 1 millón ===
if (nrow(roc_total) > 1000000) {
set.seed(2025)
roc_total <- roc_total %>% sample_n(10000) %>% arrange(Modelo, FPR)
}
# === Gráfico comparativo de curvas ROC ===
ggplot(roc_total, aes(x = FPR, y = TPR, color = Modelo)) +
geom_line(linewidth = 1) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
labs(
title = "Curvas ROC comparativas (CART)",
subtitle = paste(
"AUC promedio:",
paste(unique(paste(roc_total$Modelo, "=", roc_total$AUC)), collapse = " | ")
),
x = "Tasa de falsos positivos (1 - Especificidad)",
y = "Tasa de verdaderos positivos (Sensibilidad)",
color = "Método de muestreo"
) +
theme_minimal(base_size = 13) +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold"),
plot.subtitle = element_text(size = 11),
panel.grid.minor = element_blank()
)
